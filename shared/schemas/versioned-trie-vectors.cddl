; Schema of shared/vectors/versioned_trie_v1.json (conformance vectors for docs/specs/versioned-trie.md).
; "cbor" fields are hex of canonical CBOR: proofs and deltas in the shape of shared/schemas/versioned-trie.cddl,
; values as canonical values. Every proof is against the final commit's root.

versioned-trie-vectors = {
  "spec": "docs/specs/versioned-trie.md",
  "version": 1,
  "hash": "SHA-256",
  "width": uint,
  "emptyStateRoot": hex,
  "head": vt-head-kat,
  "commits": [* vt-commit],
  "root": hex,
  "proofs": [* vt-proof],
  "snapshot": vt-snapshot,
  "stateKeys": [* vt-state-key],
  "versionKeys": [* vt-version-key],
}

; The default version key (section 2) at its edges. "key" is "version" as 8 unsigned big-endian bytes, the JLVM's
; int_to_bytes [version, 8]; "valid" says whether the version key accepts it (versions 0..2^63-1), encoding the
; version and decoding the key alike.
vt-version-key = { "version": uint, "key": hex, "valid": bool }

; A candidate state key: whether it matches versioned-trie.cddl's state-key pattern ("schema"), and whether the full
; grammar of section 2, with its length and segment limits, accepts it ("valid").
vt-state-key = { "key": text, "schema": bool, "valid": bool }

; The final commit's snapshot, in chunks of at most "chunkEntries" items: each is the hex of a canonical
; versioned-trie-snapshot-chunk. Restoring it into an empty store reproduces "root".
vt-snapshot = { "chunkEntries": uint, "chunks": [+ hex] }

; The top trie for one head, slot by slot: "root" is the commitment root.
vt-head-kat = {
  "version": uint,
  "vkey": hex,
  "stateRoot": hex,
  "historyRoot": hex,
  "cbor": hex,
  "root": hex,
}

vt-commit = {
  "version": uint,
  "upserts": [* vt-entry],
  "removes": [* text],
  "stateRoot": hex,
  "historyRoot": hex,
  "root": hex,
  "delta": hex,
}

vt-entry = { "key": text, "value": hex }

; A key's value (canonical CBOR) or, with no "value", its absence.
vt-claim = { "key": text, ? "value": hex }

vt-listing = { "namespace": text, "entries": [* vt-entry] }

; A version answer: a version and its state root, or, empty, "none" / "not committed".
vt-version = { ? "version": uint, ? "stateRoot": hex }

vt-kind = "state" / "historical" / "version" / "asOf" / "head" / "versions"

; "at" is the version a historical, version or as-of query names, or the start of a "versions" query: the committed
; versions in [at, until), no "until" being unbounded, are exactly "versions" (each with both fields).
vt-proof = {
  "name": text,
  "kind": vt-kind,
  ? "at": uint,
  ? "until": uint,
  "cbor": hex,
  ? "claims": [* vt-claim],
  ? "listings": [* vt-listing],
  ? "answer": vt-version,
  ? "versions": [* vt-version],
}

hex = text .regexp "([0-9a-f]{2})*"
