; Schema of shared/vectors/vrf_v1.json (conformance vectors for docs/specs/vrf.md).

vrf-vectors = {
  "spec": "docs/specs/vrf.md",
  "version": 1,
  "suites": [* vrf-suite],
  "rejections": [* vrf-rejection],
  "keyDecoding": [* vrf-key-case],
}

; A verification verdict: "valid", or the VrfError kind (vrf.md section 3). "Malformed" is a wrong length (the
; proof's is checked before the key's). "suite" is a suite name of the suites list.
vrf-rejection = { "suite": text, "name": text, "verifyingKey": hex, "alpha": hex, "pi": hex, "result": vrf-result }

vrf-result =
  "valid" / "Malformed" / "InvalidPublicKey" / "SmallOrderPublicKey" / "InvalidGamma" / "NonCanonicalScalar" /
  "ChallengeMismatch"

; How a suite's decoder classifies an encoded signing key: "accepted", or its VrfError kind. A wrong length is
; "Malformed"; a draft-03 key (seed || pk) whose pk is not its seed's is "KeyMismatch". Verification decodes the
; verifying keys, so the rejections pin those.
vrf-key-case = { "suite": text, "name": text, "bytes": hex, "result": vrf-key-result }

vrf-key-result = "accepted" / "Malformed" / "KeyMismatch"

vrf-suite = { "suite": text, "keys": [* vrf-key] }

vrf-key = { "seed": hex, "signingKey": hex, "verifyingKey": hex, "proofs": [* vrf-proof] }

vrf-proof = { "alpha": hex, "pi": hex, "beta": hex }

hex = text .regexp "([0-9a-f]{2})*"
