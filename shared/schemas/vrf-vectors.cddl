; Schema of shared/vectors/vrf_v1.json (conformance vectors for docs/specs/vrf.md).

vrf-vectors = {
  "spec": "docs/specs/vrf.md",
  "version": 1,
  "suites": [* vrf-suite],
  "rejections": [* vrf-rejection],
}

; A verification verdict: "valid", or the VrfError kind (vrf.md section 3): "Malformed" (a wrong length; the proof's
; is checked before the key's), "InvalidPublicKey", "SmallOrderPublicKey", "InvalidGamma", "NonCanonicalScalar" or
; "ChallengeMismatch". "suite" is a suite name of the suites list.
vrf-rejection = { "suite": text, "name": text, "verifyingKey": hex, "alpha": hex, "pi": hex, "result": text }

vrf-suite = { "suite": text, "keys": [* vrf-key] }

vrf-key = { "seed": hex, "signingKey": hex, "verifyingKey": hex, "proofs": [* vrf-proof] }

vrf-proof = { "alpha": hex, "pi": hex, "beta": hex }

hex = text .regexp "([0-9a-f]{2})*"
