; Schema of shared/vectors/trie_v1.json (conformance vectors for docs/specs/trie.md).
; "cbor" is hex of a canonical proof, whose shape is shared/schemas/trie.cddl.

trie-vectors = {
  "spec": "docs/specs/trie.md",
  "version": 1,
  "hash": "SHA-256",
  "emptyRoot": hex,
  "nodeHashes": trie-node-hashes,
  "fixtures": [* trie-fixture],
  "malformed": [* trie-malformed],
}

; A refused proof (canonical CBOR) and the kind of its error (section 4). Decoding refuses, as "Encoding", what a
; reader sees without the mode: the record shapes, segment lengths and padding, the branch invariant, the pre-order
; structure and trailing records. Verification refuses, as "InvalidProof", what the mode decides: where leaves and
; branch values may end, and the key-length bound. "root" is what the records hash to, so only those rules refuse an
; "InvalidProof" case; it is the empty root for the "Encoding" cases.
trie-malformed = { "name": text, "mode": trie-mode, "root": hex, "cbor": hex, "error": trie-malformed-error }

trie-malformed-error = "Encoding" / "InvalidProof"

trie-node-hashes = {
  "leaf": trie-leaf-hash,
  "branch": trie-branch-hash,
}

trie-leaf-hash = { "segment": trie-bits, "valueHash": hex, "hash": hex }

trie-branch-hash = { "segment": trie-bits, "valueHash": hex, "left": hex, "hash": hex }

trie-bits = { "bits": uint, "bytes": hex }

trie-fixture = {
  "name": text,
  "mode": trie-mode,
  "entries": [* trie-entry],
  "root": hex,
  "proof": trie-proof-vector,
}

trie-mode = trie-fixed-mode / trie-variable-mode

trie-fixed-mode = { "fixed": uint }

trie-variable-mode = { "variable": uint }

trie-entry = { "key": hex, "value": hex, "valueHash": hex }

; The proof covers "keys", "prefixes" and "ranges". "rangeListings" answers each of "ranges", then further range
; probes, some of which the proof does not cover.
trie-proof-vector = {
  "keys": [* hex],
  "prefixes": [* hex],
  "ranges": [* trie-range],
  "cbor": hex,
  "lookups": [* trie-lookup],
  "prefixListings": [* trie-prefix-listing],
  "rangeListings": [* trie-range-listing],
}

; [from, until) in bitwise key order, a proper prefix before its extensions; no "until" is unbounded. The bounds are
; byte strings that need not be keys.
trie-range = { "from": hex, ? "until": hex }

trie-range-listing = { "from": hex, ? "until": hex, "result": trie-range-result }

trie-range-result = trie-range-entries / "notCovered"

trie-range-entries = { "entries": [* trie-listed] }

trie-lookup = { "key": hex, "result": trie-lookup-result }

trie-lookup-result = trie-present / "absent" / "notCovered"

trie-present = { "present": hex }

trie-prefix-listing = { "prefix": hex, "entries": [* trie-listed] }

trie-listed = { "key": hex, "valueHash": hex }

hex = text .regexp "([0-9a-f]{2})*"
