;# import jlvm-errors as errors
;# import jlvm as jlvm
;# import crypto-errors as crypto
;# import hash-errors as hash
;# import proofs-errors as proofs
; Schema of shared/vectors/jlvm_v1.json (conformance vectors for docs/specs/jlvm.md, language v1, gas schedule v1).
; Each case is a program in the strict surface and its input data, both as JSON surface text, evaluated with the
; case's host bindings (none if absent; each value is JSON surface text, or, under "built", a value built with shared
; parts), its gas limit (the file's gasLimit if absent) and the default schedule. An implementation conforms when it
; gives the same outcome and uses the same gas on every case.

jlvm-vectors = {
  "spec": "docs/specs/jlvm.md",
  "version": 1,
  "schedule": 1,
  "gasLimit": uint,
  "source": text,
  "cases": [* jlvm-case],
  "aliases": [* jlvm-alias],
}

jlvm-case = {
  "name": text,
  "program": text,
  "data": text,
  ? "env": { * text => text },
  ? "built": { * text => built-value },
  ? "gasLimit": uint,
  "outcome": jlvm-outcome,
  "gasUsed": uint,
  "warnings": uint,
}

; A value as its canonical CBOR (canonical-encoding.md), with its JSON surface text when it has one; or an error by
; its kind and normative fields (jlvm.md section 3). Messages are not part of conformance.
jlvm-outcome = jlvm-value / jlvm-error

jlvm-value = { "cbor": hex, ? "json": text }

; "op" is present exactly for the kinds Type, Arity, Arithmetic, Domain and Crypto: the wire name of the operation that
; refused (jlvm.cddl), or "var" for the read of a computed path. "cause" is present exactly when a Crypto error wraps a
; cryptographic family's refusal (jlvm.md section 3). OutOfGas is pinned by its kind and the case's gasUsed.
jlvm-error = { "error": jlvm-error-kind, ? "op": errors.jlvm-site, ? "cause": jlvm-cause }

; The refusal a Crypto error wraps (jlvm-errors.cddl `jlvm-crypto-cause`): its family, as the one key, and that family's
; kind.
jlvm-cause =
  jlvm-signing-cause / jlvm-sigma-cause / jlvm-zk-cause / jlvm-groth16-cause / jlvm-vrf-cause / jlvm-hash-cause /
  jlvm-merkle-cause / jlvm-trie-cause / jlvm-poseidon-cause / jlvm-poseidon-merkle-cause

jlvm-signing-cause = { "signing": crypto.crypto-error-kind }

jlvm-sigma-cause = { "sigma": crypto.sigma-error-kind }

jlvm-zk-cause = { "zk": crypto.zk-error-kind }

jlvm-groth16-cause = { "groth16": crypto.groth16-error-kind }

jlvm-vrf-cause = { "vrf": crypto.vrf-error-kind }

jlvm-hash-cause = { "hash": hash.hash-error-kind }

jlvm-merkle-cause = { "merkle": proofs.merkle-error-kind }

jlvm-trie-cause = { "trie": proofs.trie-error-kind }

jlvm-poseidon-cause = { "poseidon": proofs.poseidon-error-kind }

jlvm-poseidon-merkle-cause = { "poseidonMerkle": proofs.poseidon-merkle-error-kind }

; A surface alias of an operation (jlvm.md section 1): "program", which names "alias", parses to the program "own"
; writes with the operation's own name, "op"; its canonical form ("cbor", canonical CBOR of jlvm.cddl's jlvm-program)
; names "op", never the alias; and "id" is that form's identity, taggedHash_SHA-256("dilf4s/jlvm/program/v1", cbor).
jlvm-alias = { "alias": text, "op": jlvm.jlvm-op, "program": text, "own": text, "cbor": hex, "id": hex }

; A kind of JlvmError (jlvm-errors.cddl).
jlvm-error-kind = errors.jlvm-error-kind

; A host binding too heavy to write out (refusal-vectors.cddl defines the same rule): start from "leaf" (canonical
; CBOR); then apply each step in order: {"template": t, "times": n} replaces, n times over, every text "$" in the
; canonical value t by the value so far; {"copies": n} makes an array of n of it. Every occurrence is the one value,
; shared, so a loader builds it with sharing and never encodes, renders or copies it whole.
built-value = { "leaf": hex, ? "steps": [* built-step] }

built-step = built-wrap / built-copies

built-wrap = { "template": hex, "times": uint }

built-copies = { "copies": uint }

hex = text .regexp "([0-9a-f]{2})*"
