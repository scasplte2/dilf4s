; Schema of shared/vectors/signing_v1.json (conformance vectors for docs/specs/signing.md).

signing-vectors = {
  "spec": "docs/specs/signing.md",
  "version": 1,
  "randomness": hex,
  "signing": [* signing-scheme],
  "bip39": [* bip39-vector],
  "slip10Ed25519": slip10-vector,
  "bip32Secp256k1": bip32-vector,
  "ed25519Bip32": icarus-vector,
  "blsPop": [* bls-pop-vector],
  "verification": [* verification-case],
  "keyDecoding": [* key-decoding-case],
  "paths": [* path-case],
  "keyRefusals": [* key-refusal],
}

; How a scheme's decoder classifies an encoded signing or verifying key: "accepted", or the kind of its typed
; error. A wrong length is "InvalidEncoding"; bytes of the right length that are not a key are "InvalidKey".
; "Ed25519-BIP32" has signing keys only (its verifying keys are Ed25519's).
key-decoding-case = {
  "scheme": text,
  "name": text,
  "part": key-part,
  "bytes": hex,
  "result": key-decoding-result,
}

key-part = "signingKey" / "verifyingKey"

key-decoding-result = "accepted" / "InvalidEncoding" / "InvalidKey"

; A derivation path (section 3) and its serialised indices (bit 31 set when hardened), or why it is refused.
path-case = { "path": text, "result": path-result }

; A refusal names the first rule the path breaks, its segments checked in order: "missingMaster" (it is not `m` and
; does not start with `m/`), "malformed" (a segment is not ASCII digits and an optional `'` or `h`), "leadingZero",
; "tooManyDigits" (more than 10), "outOfRange" (2^31 or more), "tooDeep" (a 256th segment, whatever it holds).
path-result =
  path-indices / "missingMaster" / "malformed" / "leadingZero" / "tooManyDigits" / "outOfRange" / "tooDeep"

path-indices = { "indices": [* uint] }

; PopProve of each seed's BLS key (DST BLS_POP_BLS12381G2_XMD:SHA-256_SSWU_RO_POP_).
bls-pop-vector = { "signingKey": hex, "verifyingKey": hex, "proof": hex }

; A verdict to reproduce. The verifying key is decoded first, then the signature: a malformed one is a typed error,
; recorded as the part refused and its CryptoError kind; a decoded pair verifies ("valid") or not ("invalid").
; "scheme" is a scheme of the signing list; "Ed25519" verifies under ZIP-215 and "Ed25519-libsodium" under libsodium's
; rule.
verification-case = {
  "scheme": text,
  "name": text,
  "verifyingKey": hex,
  "message": hex,
  "signature": hex,
  "result": verification-result,
}

verification-result = "valid" / "invalid" / verification-refusal

verification-refusal = { "part": verification-part, "kind": crypto-error-kind }

verification-part = "verifyingKey" / "signature"

; A CryptoError kind (signing.md section 4). BackendFailure, a JVM provider's own failure, has no row.
crypto-error-kind = "InvalidEncoding" / "InvalidKey"

; A key-derivation call the reference refuses, with its KeyError kind (signing.md sections 2 and 3). "check" names it:
; "bip39-entropy" (BIP-39 entropy to a mnemonic: "entropy"), "bip39-phrase" (a phrase to its entropy, English list:
; "phrase"), "word-list" (a word list from "words"), "slip10" and "bip32" (derivation from "seed" along "path"),
; "bip32-public" and "icarus-public" (public derivation from "verifyingKey" and "chainCode" along "path"). Every
; path given parses; a refused path is a "paths" row (InvalidPath).
key-refusal = {
  "name": text,
  "check": key-check,
  ? "entropy": hex,
  ? "phrase": text,
  ? "words": [* text],
  ? "seed": hex,
  ? "verifyingKey": hex,
  ? "chainCode": hex,
  ? "path": text,
  "kind": key-error-kind,
}

key-check = "bip39-entropy" / "bip39-phrase" / "word-list" / "slip10" / "bip32" / "bip32-public" / "icarus-public"

key-error-kind = "InvalidEntropy" / "InvalidMnemonic" / "InvalidWordList" / "InvalidDerivation"

signing-scheme = { "scheme": text, "keys": [* signing-key] }

signing-key = { "seed": hex, "signingKey": hex, "verifyingKey": hex, "signatures": [* signed-message] }

signed-message = { "message": hex, "signature": hex }

bip39-vector = { "entropy": hex, "mnemonic": text, "passphrase": text, "seed": hex }

extended-key = { "key": hex, "chainCode": hex }

slip10-vector = { "seed": hex, "path": text, "master": extended-key, "child": extended-key }

bip32-vector = {
  "seed": hex,
  "path": text,
  "master": extended-key,
  "child": extended-key,
  "verifyingKey": hex,
  "publicDerivation": bip32-public-derivation,
}

; CKDpub along the soft "path" from the key at "parentPath" (a prefix of the private path), reaching the child.
bip32-public-derivation = {
  "parentPath": text,
  "parentVerifyingKey": hex,
  "parentChainCode": hex,
  "path": text,
  "verifyingKey": hex,
  "chainCode": hex,
}

icarus-vector = {
  "entropy": hex,
  "passphrase": text,
  "root": extended-key,
  "accountPath": text,
  "account": extended-key,
  "accountVerifyingKey": hex,
  "addressPath": text,
  "address": extended-key,
  "addressVerifyingKey": hex,
  "signatures": [* signed-message],
}

hex = text .regexp "([0-9a-f]{2})*"
