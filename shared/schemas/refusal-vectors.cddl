;# import proofs-errors as errors
;# import codec-errors as codec
; Schema of shared/vectors/refusals_v1.json (conformance vectors for docs/specs/conformance.md): calls into the
; verifiers and the versioned trie, each with its outcome, a refusal by its kind and its normative fields
; (conformance.md section 3), or "accepted". Free text is never part of a vector.

refusal-vectors = {
  "spec": "docs/specs/conformance.md",
  "version": 1,
  "hash": "SHA-256",
  "cases": [* refusal-case],
}

; One call. "check" names the entry point and the arguments it reads (conformance.md section 6); a case carries only
; those. "input" is the caller's value (a proof, delta or value); "inputs" are deltas a replica applies in order;
; "zeros" is a byte input of that many zero bytes, "chunk" one given as hex. "claim" is a claimed value (a Merkle leaf, a trie value; absent
; claims absence), "entries" a claimed listing, "batch" the writes of a commit at version 1. "stateKey" is a versioned-trie state key; "key" a trie key; "at" a
; version; "size" a Merkle tree size.
refusal-case = {
  "name": text,
  "check": refusal-check,
  ? "input": built-value,
  ? "inputs": [* built-value],
  ? "zeros": uint,
  ? "chunk": hex,
  ? "mode": refusal-mode,
  ? "root": hex,
  ? "oldRoot": hex,
  ? "leafHash": hex,
  ? "key": hex,
  ? "stateKey": text,
  ? "at": uint,
  ? "size": uint,
  ? "prefix": hex,
  ? "claim": built-value,
  ? "entries": [* refusal-entry],
  ? "batch": [* refusal-upsert],
  "outcome": refusal-outcome,
}

; A write in a commit's batch: a state key and its value.
refusal-upsert = { "stateKey": text, "value": built-value }

refusal-entry = { "key": hex, "value": built-value }

refusal-check = "vt-value" / "vt-chunk" / "vt-delta" / "vt-proof" / "vt-state" / "vt-historical" / "vt-replica" / "merkle-inclusion" / "merkle-consistency" / "trie-lookup" / "poseidon-proof" / "merkle-verify" / "trie-verify" / "trie-prefix-verify" / "vt-commit"

refusal-mode = refusal-fixed-mode / refusal-variable-mode

refusal-fixed-mode = { "fixed": uint }

refusal-variable-mode = { "variable": uint }

; "accepted", or a refusal: its family as the one key naming a kind, that family's kind (proofs-errors.cddl), and the
; fields conformance.md section 3 names normative for it, each present exactly when the kind has it. A check's family
; is fixed: "vt-" checks refuse as the versioned trie, "merkle-" checks as the Merkle tree, "trie-" checks as the
; trie, and "poseidon-proof" as the Poseidon tree. A refusal that wraps another (a versioned trie's Trie and Key) names
; the inner one as its "cause", by its family and kind, as conformance.md section 1 describes. The versions a
; VersionNotIncreasing or UnknownVersion refusal names are pinned by versioned_trie_v1.json's "versionErrors", not
; here.
refusal-outcome = vt-refusal / merkle-refusal / trie-refusal / poseidon-refusal / "accepted"

vt-refusal = {
  "versionedTrie": errors.versioned-trie-error-kind,
  ? "cause": vt-cause,
  ? "limit": uint,
  ? "depth": uint,
  ? "component": errors.vt-root-component,
}

; The refusal a versioned trie's Trie or Key refusal wraps: the trie's kind, or the state key's.
vt-cause = vt-trie-cause / vt-key-cause

vt-trie-cause = { "trie": errors.trie-error-kind }

vt-key-cause = { "stateKey": codec.state-key-error-kind }

merkle-refusal = { "merkle": errors.merkle-error-kind, ? "limit": uint }

trie-refusal = { "trie": errors.trie-error-kind, ? "limit": uint }

poseidon-refusal = { "poseidonMerkle": errors.poseidon-merkle-error-kind, ? "depth": uint }

; A canonical value given by how it is built, so that a value with shared parts, far heavier than its description,
; fits in the file (canonical CBOR has no sharing). Start from "leaf" (canonical CBOR); then apply each step in order:
; {"template": t, "times": n} replaces, n times over, every text "$" in the canonical value t by the value so far;
; {"copies": n} makes an array of n of it. Every occurrence is the one value, shared: a built value can weigh up to
; 2^63 - 1 (its weight saturates), so a loader builds it with sharing and never encodes, renders or copies it whole.
built-value = { "leaf": hex, ? "steps": [* built-step] }

built-step = built-wrap / built-copies

built-wrap = { "template": hex, "times": uint }

built-copies = { "copies": uint }

hex = text .regexp "([0-9a-f]{2})*"
