    {
      "name": "warning: a plain path shadows the root",
      "program": "{\"map\":[{\"var\":\"xs\"},{\"var\":\"x\"}]}",
      "data": "{\"x\":0,\"xs\":[{\"x\":2}]}"
    },
    {
      "name": "warning: explicit current avoids ambiguity",
      "program": "{\"map\":[{\"var\":\"xs\"},{\"var\":\"$current.x\"}]}",
      "data": "{\"x\":0,\"xs\":[{\"x\":2}]}"
    },
    {
