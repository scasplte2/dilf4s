{
  "name": "@kd5ujc/dilf4s-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "dilf4s JLVM as a Model Context Protocol server: check, evaluate, encode and hash JLVM programs and values over stdio",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "./dist/bin.js"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "dilf4s-jlvm-mcp": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postbuild": "vitest run --config vitest.smoke.config.ts"
  },
  "dependencies": {
    "@kd5ujc/dilf4s-core": "0.1.0",
    "@kd5ujc/dilf4s-jlvm": "0.1.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  }
}
