# ------------------------------------------------------------------------------------------------ versioned tries

@final
class VersionKey:
    """How a version becomes a history-trie key."""

    @staticmethod
    def unsigned_long(width: int | None = None) -> _Result[VersionKey, _vt.VersionedTrieError | _Mismatch]: ...
    @staticmethod
    def bytes(width: int) -> _Result[VersionKey, _vt.VersionedTrieError | _Mismatch]: ...
    @property
    def kind(self) -> Literal["unsignedLong", "bytes"]: ...
    @property
    def width(self) -> int: ...

type _Version = int | builtins.bytes
type _VtResult[T] = _Result[T, _vt.VersionedTrieError | _Mismatch]

@final
class VersionedTrie:
    """A versioned trie's configuration: the version key and the hash."""

    @staticmethod
    def of(
        version_key: VersionKey, algorithm: str | None = None
    ) -> _Result[VersionedTrie, _vt.VersionedTrieError | _hash.HashError | _Mismatch]: ...
    @property
    def algorithm(self) -> _t.HashAlgorithmName: ...
    @property
    def version_key(self) -> VersionKey: ...
    @property
    def empty_state_root(self) -> builtins.bytes: ...
    def vkey(self, version: _Version) -> _VtResult[builtins.bytes]: ...
    def value_hash(self, value: Value) -> _VtResult[builtins.bytes]: ...
    def bytes_hash(self, b: _Bytes) -> _VtResult[builtins.bytes]: ...
    def check_value(self, key: str, value: Value) -> _VtResult[None]: ...
    def decode_head(self, form: Value) -> _VtResult[_p.VersionedHead]: ...
    def encode_head(self, head: _p.VersionedHead) -> _VtResult[Value]: ...
    def root(self, head: _p.VersionedHead) -> _VtResult[builtins.bytes]: ...
    def decode_delta(self, form: Value) -> _VtResult[_p.Delta]: ...
    def decode_chunk(self, data: _Bytes) -> _VtResult[_p.SnapshotChunk]: ...
    def decode_proof(self, form: Value) -> _VtResult[_p.VersionedHead]: ...
    def verify_head(self, root: _Bytes, proof: Value) -> _VtResult[_p.VersionedHead]: ...
    def verify_state(self, root: _Bytes, proof: Value) -> _VtResult[VerifiedState]: ...
    def verify_historical_key(self, root: _Bytes, proof: Value, at: _Version) -> _VtResult[VerifiedState]: ...
    def verify_version(self, root: _Bytes, proof: Value, at: _Version) -> _VtResult[builtins.bytes | None]: ...
    def verify_versions[V: tuple[_Version, _Bytes]](
        self,
        root: _Bytes,
        proof: Value,
        start: _Version,
        until: _Version | None,
        claimed: _Items[V],
    ) -> _VtResult[bool]: ...
    def verify_as_of(
        self, root: _Bytes, proof: Value, at: _Version
    ) -> _VtResult[tuple[_Version, builtins.bytes] | None]: ...

@final
class VerifiedState:
    """A state proof checked against a trusted root."""

    def lookup(self, key: str) -> _VtResult[bytes | None]: ...
    def holds(self, key: str, claimed: Value | None = None) -> _VtResult[bool]: ...
    def namespace(self, ns: str) -> _VtResult[tuple[tuple[str, bytes], ...]]: ...
    def range(self, start: str, until: str | None = None) -> _VtResult[tuple[tuple[str, bytes], ...]]: ...

@final
class Replica:
    """A versioned trie's whole state and history, following deltas. Applying a delta gives a new replica."""

    @staticmethod
    def empty(vt: VersionedTrie) -> _Result[Replica, _Mismatch]: ...
    @staticmethod
    def restore[B: _Bytes](vt: VersionedTrie, trusted: _p.VersionedHead, chunks: _Items[B]) -> _VtResult[Replica]: ...
    @property
    def head(self) -> _p.VersionedHead | None: ...
    def root(self) -> _VtResult[bytes | None]: ...
    def get(self, key: str) -> _VtResult[Value | None]: ...
    def entries(self) -> tuple[tuple[str, Value], ...]: ...
    def apply_delta(self, delta: Value) -> _VtResult[Replica]: ...
    def __len__(self) -> int: ...

