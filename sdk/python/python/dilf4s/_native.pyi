type _Mismatch = _canonical.TypeMismatch
type _Bytes = _t.Buffer
type _Items[T] = list[T] | tuple[T, ...]
"""A sequence argument: a list or a tuple, read with the concrete API (any other sequence is a `TypeMismatch`)."""
type _Pair = tuple[_Bytes, _Bytes]
