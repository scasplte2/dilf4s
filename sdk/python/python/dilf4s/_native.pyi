@final
class Program:
    """A JLVM program: language version 1, bounded, with one canonical form."""

    def canonical(self) -> _Result[Value, _jlvm.JlvmError]: ...
    def encode(self) -> _Result[bytes, _jlvm.JlvmError]: ...
    def id(self, algorithm: str | None = None) -> _Result[bytes, _jlvm.JlvmError | _hash.HashError | _Mismatch]: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...
    def __hash__(self) -> int: ...

@final
class Compiled:
    """A program whose special forms are checked, ready to evaluate any number of times."""

    @property
    def program(self) -> Program: ...

def jlvm_parse(source_text: str) -> _Result[Program, _jlvm.JlvmError | _Mismatch]: ...
def jlvm_parse_value(source_text: str) -> _Result[Value, _jlvm.JlvmError | _Mismatch]: ...
def jlvm_from_canonical(form: Value) -> _Result[Program, _jlvm.JlvmError | _Mismatch]: ...
