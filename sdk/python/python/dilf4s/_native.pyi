@final
class Value:
    """A canonical value: immutable, its parts shared."""

    @staticmethod
    def null() -> Value: ...
    @staticmethod
    def bool(b: builtins.bool) -> _Result[Value, _Mismatch]: ...
    @staticmethod
    def int(n: builtins.int) -> _Result[Value, _canonical.IntegerTooWide | _Mismatch]: ...
    @staticmethod
    def number(
        numerator: builtins.int, denominator: builtins.int
    ) -> _Result[Value, _canonical.IntegerTooWide | _canonical.RationalTooWide | _DivisionByZero | _Mismatch]: ...
    @staticmethod
    def text(s: str) -> _Result[Value, _canonical.UnpairedSurrogate | _Mismatch]: ...
    @staticmethod
    def bytes(b: _Bytes) -> _Result[Value, _Mismatch]: ...
    @staticmethod
    def array(values: list[Value] | tuple[Value, ...]) -> _Result[Value, _canonical.DepthExceeded | _Mismatch]: ...
    @staticmethod
    def map(
        fields: dict[str, Value],
    ) -> _Result[Value, _canonical.DepthExceeded | _canonical.UnpairedSurrogate | _Mismatch]: ...
    @staticmethod
    def of(obj: _t.Data) -> _Result[Value, _canonical.CanonicalError]: ...
    @property
    def kind(self) -> Literal["null", "bool", "int", "rational", "text", "bytes", "array", "map"]: ...
    @property
    def depth(self) -> builtins.int: ...
    @property
    def weight(self) -> builtins.int: ...
    def as_bool(self) -> builtins.bool | None: ...
    def as_int(self) -> builtins.int | None: ...
    def as_rational(self) -> Fraction | None: ...
    def as_text(self) -> str | None: ...
    def as_bytes(self) -> builtins.bytes | None: ...
    def as_array(self) -> tuple[Value, ...] | None: ...
    def as_map(self) -> dict[str, Value] | None: ...
    def get(self, key: str) -> Value | None: ...
    def to_python(self, max_weight: builtins.int) -> _Result[_t.PythonData, _TooLarge | _Mismatch]: ...
    def __eq__(self, other: object, /) -> builtins.bool: ...
    def __ne__(self, other: object, /) -> builtins.bool: ...
    def __hash__(self) -> builtins.int: ...

def cbor_encode(value: Value) -> _Result[bytes, _Mismatch]: ...
