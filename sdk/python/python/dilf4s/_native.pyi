def jlvm_compile(program: Program) -> _Result[Compiled, _jlvm.JlvmError | _Mismatch]: ...
def jlvm_evaluate(
    program: Program | Compiled,
    data: Value,
    bindings: dict[str, Value] | None = None,
    gas_limit: int | None = None,
) -> _Result[_j.Outcome, _Mismatch]: ...

