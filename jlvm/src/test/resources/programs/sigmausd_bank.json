{"let": [[
  ["s", {"var": "state"}],
  ["c", {"var": "call"}],
  ["P", {"var": "oracle.rate"}],
  ["R", {"var": "state.reserve"}],
  ["S", {"var": "state.stable"}],
  ["Rc", {"var": "state.reserveCoins"}],
  ["n", {"var": "call.amount"}],
  ["L", {"if": [{"==": [{"var": "$S"}, 0]}, 0, {"min": [{"*": [{"var": "$S"}, {"var": "$P"}]}, {"var": "$R"}]}]}],
  ["E", {"-": [{"var": "$R"}, {"var": "$L"}]}],
  ["stablePrice", {"if": [{"==": [{"var": "$S"}, 0]}, {"var": "$P"}, {"min": [{"var": "$P"}, {"/": [{"var": "$R"}, {"var": "$S"}]}]}]}],
  ["reservePrice", {"if": [{"or": [{"==": [{"var": "$Rc"}, 0]}, {"<=": [{"var": "$E"}, 0]}]}, {"var": "state.defaultReservePrice"}, {"/": [{"var": "$E"}, {"var": "$Rc"}]}]}],
  ["up", {"/": [{"+": [100, {"var": "state.feePercent"}]}, 100]}],
  ["down", {"/": [{"-": [100, {"var": "state.feePercent"}]}, 100]}]
 ],
 {"if": [
  {"or": [{"<=": [{"var": "$n"}, 0]}, {"!=": [{"floor": {"var": "$n"}}, {"var": "$n"}]}]},
  {"object": {"reject": "a positive whole amount"}},

  {"==": [{"var": "$c.method"}, "mintStable"]},
  {"let": [[["cost", {"ceil": {"*": [{"var": "$n"}, {"var": "$stablePrice"}, {"var": "$up"}]}}]],
   {"if": [
    {">=": [{"*": [{"+": [{"var": "$R"}, {"var": "$cost"}]}, 100]}, {"*": [400, {"+": [{"var": "$S"}, {"var": "$n"}]}, {"var": "$P"}]}]},
    {"state": {"merge": [{"var": "$s"}, {"reserve": {"+": [{"var": "$R"}, {"var": "$cost"}]}, "stable": {"+": [{"var": "$S"}, {"var": "$n"}]}}]},
     "effects": [{"kind": "charge", "amount": {"var": "$cost"}}, {"kind": "mintStable", "amount": {"var": "$n"}}]},
    {"object": {"reject": "minting stablecoins would take the reserve ratio below 400%"}}
   ]}
  ]},

  {"==": [{"var": "$c.method"}, "redeemStable"]},
  {"let": [[["payout", {"floor": {"*": [{"var": "$n"}, {"var": "$stablePrice"}, {"var": "$down"}]}}]],
   {"if": [
    {"<=": [{"var": "$n"}, {"var": "$S"}]},
    {"state": {"merge": [{"var": "$s"}, {"reserve": {"-": [{"var": "$R"}, {"var": "$payout"}]}, "stable": {"-": [{"var": "$S"}, {"var": "$n"}]}}]},
     "effects": [{"kind": "burnStable", "amount": {"var": "$n"}}, {"kind": "pay", "amount": {"var": "$payout"}}]},
    {"object": {"reject": "more stablecoins than exist"}}
   ]}
  ]},

  {"==": [{"var": "$c.method"}, "mintReserve"]},
  {"let": [[["cost", {"ceil": {"*": [{"var": "$n"}, {"var": "$reservePrice"}, {"var": "$up"}]}}]],
   {"if": [
    {"or": [{"==": [{"var": "$S"}, 0]}, {"<=": [{"*": [{"+": [{"var": "$R"}, {"var": "$cost"}]}, 100]}, {"*": [800, {"var": "$S"}, {"var": "$P"}]}]}]},
    {"state": {"merge": [{"var": "$s"}, {"reserve": {"+": [{"var": "$R"}, {"var": "$cost"}]}, "reserveCoins": {"+": [{"var": "$Rc"}, {"var": "$n"}]}}]},
     "effects": [{"kind": "charge", "amount": {"var": "$cost"}}, {"kind": "mintReserve", "amount": {"var": "$n"}}]},
    {"object": {"reject": "minting reservecoins would take the reserve ratio above 800%"}}
   ]}
  ]},

  {"==": [{"var": "$c.method"}, "redeemReserve"]},
  {"let": [[["payout", {"floor": {"*": [{"var": "$n"}, {"var": "$reservePrice"}, {"var": "$down"}]}}]],
   {"if": [
    {"and": [
      {"<=": [{"var": "$n"}, {"var": "$Rc"}]},
      {"or": [{"==": [{"var": "$S"}, 0]}, {">=": [{"*": [{"-": [{"var": "$R"}, {"var": "$payout"}]}, 100]}, {"*": [400, {"var": "$S"}, {"var": "$P"}]}]}]}
    ]},
    {"state": {"merge": [{"var": "$s"}, {"reserve": {"-": [{"var": "$R"}, {"var": "$payout"}]}, "reserveCoins": {"-": [{"var": "$Rc"}, {"var": "$n"}]}}]},
     "effects": [{"kind": "burnReserve", "amount": {"var": "$n"}}, {"kind": "pay", "amount": {"var": "$payout"}}]},
    {"object": {"reject": "redeeming reservecoins would take the reserve ratio below 400%"}}
   ]}
  ]},

  {"object": {"reject": "unknown method"}}
 ]}
]}
